# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Databases (Offline-First Architecture)
# Primary Database (Local MongoDB - Required for offline operation)
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/festflow

# Secondary Database (MongoDB Atlas - Cloud backup and sync target)
CLOUD_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/festflow?retryWrites=true&w=majority

# Legacy fallback (maintained for backwards compatibility)
MONGODB_URI=mongodb://127.0.0.1:27017/festflow

# Cloud Synchronization Settings
ENABLE_CLOUD_SYNC=true
SYNC_INTERVAL_MS=30000

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
