# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your MongoDB Atlas URI or keep local MongoDB)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/festflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/festflow

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
