# CampusFix Environment Configuration
# Copy this file to .env for local development

# Flask Settings
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=campusfix-dev-insecure-secret-key-change-in-production

# Database Configuration
# Local development default: SQLite
DATABASE_URL=sqlite:///campusfix_dev.db

# Production / Docker PostgreSQL Connection String:
# DATABASE_URL=postgresql://campusfix_user:campusfix_secure_pass_2026@localhost:5432/campusfix

# Server Settings
PORT=5000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
